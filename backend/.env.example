# Copier ce fichier en ".env" en local et remplir les vraies valeurs.
# Ne jamais committer le ".env" réel — il est déjà exclu par .gitignore.
# En production (Render, etc.), ces variables se définissent dans le tableau de bord d'hébergement, pas dans ce fichier.

PORT=4000

# Obligatoire : secret pour signer les sessions (JWT). Générer avec : openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_secret

# Compte admin créé automatiquement au premier démarrage (ou promu si l'email existe déjà)
ADMIN_EMAIL=admin@rentify.cm
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Administrateur Rentify

# Base de données Turso (SQLite hébergé, gratuit et persistant).
# Laisser VIDE en local : le backend utilise alors un simple fichier SQLite (backend/data/roomia.db), sans compte Turso.
# En production, remplir avec les valeurs données par `turso db show` / `turso db tokens create` (voir README).
# TURSO_DATABASE_URL=libsql://ton-alias-ton-compte.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# CamPay — Mobile Money automatique (MTN MoMo + Orange Money). Crée un compte sur https://www.campay.net
# (ou https://demo.campay.net pour tester avec de faux montants < 100 FCFA), crée une application,
# puis colle soit le jeton permanent (le plus simple), soit le username/password de l'application.
# Laisser VIDE : le Mobile Money automatique est alors désactivé et seul le wallet crypto manuel fonctionne.
# ⚠️ Intégration écrite avec soin mais non testée en conditions réelles (pas d'accès réseau en dev) — teste
# d'abord en mode demo avant de passer CAMPAY_MODE=live. Voir README.
CAMPAY_MODE=demo
# CAMPAY_PERMANENT_TOKEN=...
# CAMPAY_USERNAME=...
# CAMPAY_PASSWORD=...
# Dans ton tableau de bord CamPay, mets l'URL de webhook sur : https://tondomaine.cm/api/payments/campay/webhook

# Numéro WhatsApp de l'admin pour le bouton de contact flottant (format international, sans le +).
# ⚠️ À REMPLACER — c'est un placeholder.
WHATSAPP_ADMIN_NUMBER=237600000000

# Web Push (notifications système réelles, même onglet fermé). Générer une paire de clés VAPID avec :
#   npx web-push generate-vapid-keys
# Laisser VIDE : les notifications restent alors en direct dans le site (cloche + toasts) mais pas au niveau système.
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
VAPID_CONTACT_EMAIL=admin@lokaya.cm

# Email (vérification d'email à l'inscription + mot de passe oublié automatique) via Resend —
# https://resend.com — 3000 emails/mois gratuits à vie, 100/jour, sans carte bancaire.
# 1. Crée un compte, vérifie ton domaine (ou utilise leur domaine de test pour commencer)
# 2. Crée une clé API
# Laisser VIDE : l'inscription et la connexion continuent de fonctionner normalement, juste sans
# email automatique (mot de passe oublié repasse alors par l'admin, comme avant).
# ⚠️ Intégration écrite avec soin mais non testée en conditions réelles (pas d'accès réseau en dev).
# RESEND_API_KEY=re_...
# EMAIL_FROM=Lokaya <noreply@tondomaine.cm>

# Crypto (repli manuel, discret) : pas de variable d'environnement — l'adresse wallet affichée aux
# clients se configure directement dans l'admin (Paiements → Crypto), pas ici. Paiement manuel :
# le client envoie, colle le hash de sa transaction, tu vérifies et valides dans l'admin.
